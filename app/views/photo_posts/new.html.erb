<h1>観光スポットの写真投稿</h1>

<% if @photo_post.errors.any? %>
  <div style="color: red; margin-bottom: 12px;">
    <p><strong><%= @photo_post.errors.count %>件のエラーがあります：</strong></p>
    <ul>
      <% @photo_post.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @photo_post, local: true do |f| %>
  <div style="margin-bottom: 12px;">
    <%= f.label :spot_id, "観光スポットを選択" %><br>
    <%= f.collection_select :spot_id, @spots, :id, :name, { prompt: "スポットを選択してください" } %>
  </div>

  <div style="margin-bottom: 12px;">
    <%= f.label :image_url, "写真URL" %><br>
    <%= f.text_field :image_url, placeholder: "https://example.com/photo.jpg", size: 50 %>
  </div>

  <div>
    <%= f.submit "投稿して審査を申請する" %>
  </div>
<% end %>

<p style="margin-top: 16px;">
  <%= link_to "スポット一覧へ戻る", spots_path %> |
  <%= link_to "自分の投稿履歴へ", photo_posts_path %>
</p>
<body>
    <% if current_user %>
      <header style="background-color: #f4f4f4; padding: 12px 20px; border-bottom: 1px solid #ddd; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <strong>ログイン中:</strong> <%= current_user.name %>
          （ロール: <%= current_user.role == "admin" ? "管理者" : "観光客" %>） |
          <strong>保有ポイント:</strong> <%= current_user.current_points %> pt
        </div>
        <div>
          <%= button_to "ログアウト", logout_path, method: :delete %>
        </div>
      </header>
    <% end %>

    <% if notice %>
      <p style="color: green; padding: 8px 20px;"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p style="color: red; padding: 8px 20px;"><%= alert %></p>
    <% end %>

    <main style="padding: 20px;">
      <%= yield %>
    </main>
  </body>
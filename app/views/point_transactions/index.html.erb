<div class="container">
  <h1>ポイント履歴・利用</h1>

  <% if notice %>
    <p style="color: green;"><%= notice %></p>
  <% end %>
  <% if alert %>
    <p style="color: red;"><%= alert %></p>
  <% end %>

  <div class="current-points-box" style="border: 1px solid #ccc; padding: 16px; margin-bottom: 20px;">
    <h2>現在の保有ポイント</h2>
    <p style="font-size: 24px; font-weight: bold;"><%= @current_points %> pt</p>
    <%= link_to "ポイントを利用する", new_point_transaction_path, class: "btn btn-primary" %>
  </div>

  <h2>ポイント獲得・利用履歴</h2>
  <% if @point_transactions.any? %>
    <table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr>
          <th>日時</th>
          <th>種別</th>
          <th>ポイント数</th>
        </tr>
      </thead>
      <tbody>
        <% @point_transactions.each do |transaction| %>
          <tr>
            <td><%= l transaction.created_at, format: :short rescue transaction.created_at.strftime("%Y/%m/%d %H:%M") %></td>
            <td><%= transaction.transaction_type %></td>
            <td>
              <% if transaction.transaction_type == "利用" %>
                -<%= transaction.amount %> pt
              <% else %>
                +<%= transaction.amount %> pt
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>ポイントの履歴はまだありません。</p>
  <% end %>

  <div style="margin-top: 20px;">
    <%= link_to "トップ画面へ戻る", root_path %>
  </div>
</div>